{% extends "base.html.j2" %}
{% block header %}
<header class="site-header">
  <div class="header-inner">
    <a class="brand-link" href="https://www.netresearch.de/">
      <svg viewBox="-75 -75 440 440" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Netresearch DTT GmbH">
        <title>Netresearch DTT GmbH</title>
        <path fill="#2F99A4" d="M209.6,0V31.62h32.77a26.38,26.38,0,0,1,26.44,26.43V242a26.38,26.38,0,0,1-26.44,26.44H209.6V300h47.93a42.77,42.77,0,0,0,42.86-42.86V42.89A42.76,42.76,0,0,0,257.53,0ZM43.25,0A42.76,42.76,0,0,0,.39,42.89V257.18A42.76,42.76,0,0,0,43.25,300H91.18V268.46H58.4A26.38,26.38,0,0,1,32,242v-184A26.37,26.37,0,0,1,58.4,31.62H91.18V0Z" transform="translate(-0.39 -0.04)"/>
        <path fill="#585961" d="M221.44,120.41c0-34.48-13.94-57.82-48.93-57.82-26.62,0-48.54,7.74-64.17,26.56l-.7-22.06-28.31.06V232.94h31.59V124.69c7.14-18.38,32.14-34.8,53-34.5,27.38.4,25.2,26.24,26,45.81v96.94h31.58" transform="translate(-0.39 -0.04)"/>
      </svg>
      <span class="brand-text"><span>{{ c.nav.brand_line1 }}</span> <span>{{ c.nav.brand_line2 }}</span></span>
    </a>
    <nav class="nav-links" id="site-navigation" aria-label="{{ c.nav.label }}">
      <a href="{{ c.nav.portfolio_href }}">{{ c.nav.portfolio }}</a>
      {% for item in c.nav['items'] %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
    </nav>
    <div class="header-tools">
      <a class="language-link" href="{{ c.other_href }}" hreflang="{{ c.other_lang }}" lang="{{ c.other_lang }}">{{ c.other_label }}</a>
      <label class="theme-control" for="site-theme" hidden>{{ 'Darstellung' if c.lang == 'de' else 'Appearance' }}
        <select id="site-theme" data-theme-control>
          <option value="system">System</option>
          <option value="light">{{ 'Hell' if c.lang == 'de' else 'Light' }}</option>
          <option value="dark">{{ 'Dunkel' if c.lang == 'de' else 'Dark' }}</option>
        </select>
      </label>
      <button class="menu-toggle" type="button" id="menu-toggle" aria-expanded="false" aria-controls="site-navigation" hidden>{{ c.nav.menu }}</button>
    </div>
  </div>
</header>
{% endblock %}
{% block content %}
<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{{ c.hero.eyebrow }}</p>
      <h1>{{ c.hero.title }}</h1>
      <p class="hero-lead">{{ c.hero.lead }}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="{{ contact.hero }}" data-cta="business" data-cta-position="hero">{{ c.hero.cta_business }}</a>
        <a class="btn btn-outline" href="{{ c.hero.cta_technical_href }}">{{ c.hero.cta_technical }}</a>
      </div>
    </div>
    <aside class="hero-card" aria-labelledby="start-heading">
      <h2 id="start-heading">{{ c.hero.card_title }}</h2>
      <ul class="hero-facts">{% for fact in c.hero.facts %}<li><strong>{{ fact.title }}</strong><p>{{ fact.text }}</p></li>{% endfor %}</ul>
    </aside>
  </div>
</section>
<section class="section" id="stack" aria-labelledby="stack-heading">
  <div class="container">
    <div class="section-header"><h2 id="stack-heading">{{ c.stack.heading }}</h2><p>{{ c.stack.lead }}</p></div>
    <div class="stack-explorer">
      <div class="layer-diagram" role="tablist" aria-label="{{ c.stack.heading }}" aria-orientation="vertical">
        {% for layer in c.stack.layers %}
        <button class="layer-card{% if layer.active %} is-active{% endif %}" type="button" data-layer="{{ layer.number }}" id="tab-{{ layer.number }}" role="tab" aria-selected="{{ 'true' if layer.active else 'false' }}" aria-controls="layer-panel" tabindex="{{ '0' if layer.active else '-1' }}">
          <span class="layer-head"><span class="layer-number" aria-hidden="true">{{ layer.number }}</span><span class="layer-title-wrap"><span class="layer-title">{{ layer.title }}</span><span class="layer-subtitle">{{ layer.subtitle }}</span></span></span>
          <span class="component-row">{% for component in layer.components %}<span class="component-chip">{{ component.label }}</span>{% endfor %}</span>
        </button>
        {% endfor %}
      </div>
      {% set selected = c.stack.layers | selectattr('active') | first %}
      <div class="details-panel" id="layer-panel" role="tabpanel" aria-labelledby="tab-{{ selected.number }}" tabindex="0">
        <span class="detail-kicker" id="detail-kicker">{{ selected.detail.kicker }}</span>
        <h3 id="detail-title">{{ selected.title }}</h3>
        <p id="detail-summary">{{ selected.detail.summary }}</p>
        <dl class="detail-grid">
          <div><dt>{{ c.stack.detail_labels.problem }}</dt><dd id="detail-problem">{{ selected.detail.problem }}</dd></div>
          <div><dt>{{ c.stack.detail_labels.audience }}</dt><dd id="detail-audience">{{ selected.detail.audience }}</dd></div>
          <div><dt>{{ c.stack.detail_labels.result }}</dt><dd id="detail-result">{{ selected.detail.result }}</dd></div>
        </dl>
        <div class="detail-stack"{% if not selected.detail.stack %} hidden{% endif %}>
          <p class="detail-stack-label">{{ c.stack.detail_labels.stack }}</p>
          <div class="stack-path" id="stack-path">{% for name in selected.detail.stack %}<a class="path-chip" href="{{ repos[name] }}">{{ name }}</a>{% endfor %}</div>
        </div>
        <div class="takeaway"><strong id="detail-takeaway-title">{{ selected.detail.takeaway_title }}</strong><p id="detail-takeaway">{{ selected.detail.takeaway }}</p></div>
      </div>
    </div>
    <p id="panel-state" class="sr-only" role="status" aria-live="polite"></p>
    <noscript><div class="module-grid">{% for layer in c.stack.layers %}<article class="module-card"><h3>{{ layer.title }}</h3><p>{{ layer.detail.summary }}</p><p>{{ layer.detail.result }}</p><p>{{ layer.detail.takeaway }}</p></article>{% endfor %}</div></noscript>
    <aside class="browser-path" aria-labelledby="browser-heading"><h3 id="browser-heading">{{ c.stack.browser.title }}</h3><p>{{ c.stack.browser.text }}</p><a href="{{ c.stack.browser.href }}">{{ c.stack.browser.label }} →</a></aside>
  </div>
</section>
<section class="section section-alt" id="reifegrad" aria-labelledby="maturity-heading">
  <div class="container">
    <div class="section-header"><h2 id="maturity-heading">{{ c.maturity.heading }}</h2><p>{{ c.maturity.lead }}</p></div>
    <p class="table-note">{{ c.maturity.checked }}: <time datetime="{{ facts_checked }}">{{ facts_checked }}</time> · <a href="{{ base }}stack-manifest.json">{{ c.maturity.download }}</a></p>
    <p class="table-note" id="maturity-scroll">{{ c.maturity.scroll }}</p>
    <div class="table-wrap" role="region" tabindex="0" aria-labelledby="maturity-heading" aria-describedby="maturity-scroll">
      <table class="data-table" aria-labelledby="maturity-heading">
        <thead><tr>{% for key in ['module', 'status', 'release', 'requirements', 'dependencies', 'boundary'] %}<th scope="col">{{ c.maturity.columns[key] }}</th>{% endfor %}</tr></thead>
        <tbody>{% for row in maturity_rows %}
          <tr>
            <th scope="row"><a href="{{ row.page }}">{{ row.name }}</a><span class="cell-detail">{{ row.role }}</span></th>
            <td><span class="status-pill status-{{ row.stage }}">{{ c.maturity.stages[row.stage] }}</span><a class="cell-source" href="{{ row.stage_source }}">{{ c.maturity.source }}</a></td>
            <td>{% if row.latest_release %}<a href="{{ row.repository }}/releases/tag/{{ row.latest_release }}">{{ row.latest_release }}</a><span class="cell-detail">{{ row.release_date }}</span>{% else %}<a href="{{ row.release_source }}">{{ c.maturity.no_release }}</a>{% endif %}</td>
            <td><span class="cell-detail">PHP {{ row.php }}</span><span class="cell-detail">TYPO3 {{ row.typo3 }}</span><a class="cell-source" href="{{ row.requirements_source }}">Composer{% if not row.latest_release %} · main{% endif %}</a></td>
            <td>{% if row.dependencies %}{% for name in row.dependencies %}<a class="dependency-link" href="{{ repos[name] }}">{{ name }}</a>{% endfor %}{% else %}{{ c.maturity.none }}{% endif %}</td>
            <td>{{ row.boundary }}</td>
          </tr>
        {% endfor %}</tbody>
      </table>
    </div>
    <p class="table-note">{{ c.maturity.release_note }}</p>
  </div>
</section>
<section class="section" id="betrieb" aria-labelledby="operating-heading">
  <div class="container">
    <div class="section-header"><h2 id="operating-heading">{{ c.operating.heading }}</h2><p>{{ c.operating.lead }}</p></div>
    <div class="module-grid operating-grid">{% for row in c.operating.rows %}<article class="module-card"><h3>{{ row.model }}</h3><dl><dt>{{ c.operating.columns.data }}</dt><dd>{{ row.data }}</dd><dt>{{ c.operating.columns.fit }}</dt><dd>{{ row.fit }}</dd><dt>{{ c.operating.columns.tradeoff }}</dt><dd>{{ row.tradeoff }}</dd></dl></article>{% endfor %}</div>
  </div>
</section>
<section class="section section-alt" id="governance" aria-labelledby="governance-heading">
  <div class="container">
    <div class="section-header"><h2 id="governance-heading">{{ c.governance.heading }}</h2><p>{{ c.governance.lead }}</p></div>
    <div class="module-grid">{% for row in c.governance.rows %}<article class="module-card"><h3>{{ row.decision }}</h3><p><strong>{{ c.governance.columns.owner }}:</strong> {{ row.owner }}</p><p>{{ row.evidence }}</p></article>{% endfor %}</div>
  </div>
</section>
<section class="section" id="dokumentation" aria-labelledby="docs-heading">
  <div class="container">
    <div class="section-header"><h2 id="docs-heading">{{ c.docs.heading }}</h2><p>{{ c.docs.lead }}</p></div>
    <div class="module-grid">{% for row in maturity_rows %}<article class="module-card docs-card"><h3>{{ row.name }}</h3><p>{{ row.role }}</p><p><span class="cell-detail">{{ c.docs.install }}</span><code>composer require {{ row.composer_package }}</code></p><div class="card-links"><a href="{{ row.documentation }}">{{ c.docs.manual }}</a><a href="{{ row.page }}">{{ c.docs.product }}</a></div></article>{% endfor %}</div>
    <ul class="related-links"><li><a href="{{ c.nav.portfolio_href }}">{{ c.docs.portfolio }}</a></li><li><a href="https://netresearch.github.io/t3x-nr-llm/adr/" hreflang="en">{{ c.docs.adr }}</a></li><li><a href="{{ c.docs.impact_href }}">{{ c.docs.impact }}</a></li></ul>
    <aside class="limits" id="grenzen" aria-labelledby="limits-heading"><h3 id="limits-heading">{{ c.evidence.limits_heading }}</h3><ul>{% for limit in c.evidence.limits %}<li>{{ limit }}</li>{% endfor %}</ul></aside>
  </div>
</section>
<section class="section section-alt" id="faq" aria-labelledby="faq-heading">
  <div class="container"><div class="section-header"><h2 id="faq-heading">{{ c.faq.heading }}</h2></div><div class="faq-grid">{% for item in c.faq['items'] %}<article class="faq-item"><h3>{{ item.q }}</h3><p>{{ item.a }}</p></article>{% endfor %}</div></div>
</section>
<section class="contact-band" id="kontakt" aria-labelledby="cta-heading">
  <div class="container contact-inner"><div><h2 id="cta-heading">{{ c.cta.heading }}</h2><p>{{ c.cta.lead }}</p><p>{{ c.cta.issue_note }} <a href="https://github.com/netresearch/modularer-ki-stack-page/issues/new">{{ c.cta.issue_label }}</a></p></div><div class="contact-actions"><a class="btn btn-primary" href="{{ contact.band }}" data-cta="business" data-cta-position="band">{{ c.cta.business }}</a><a class="btn btn-outline" href="{{ c.cta.technical_href }}">{{ c.cta.technical }}</a></div></div>
</section>
{% endblock %}
{% block scripts %}<script type="application/json" id="layer-data">{{ layer_data | safe }}</script><script src="{{ base }}assets/stack.js" defer></script>{% endblock %}
